{"id":"clockwork-city","title":"Clockwork City","author":"Milo Gear","difficulty":"INTERMEDIATE","description":"Navigate a mechanical metropolis before midnight.","sections":[{"id":"1","type":"BEGIN","text":"Gears turn as the city wakes.","options":[{"description":"Visit the tower","gotoId":"2"},{"description":"Enter the market","gotoId":"3"}]},{"id":"2","type":"NODE","text":"The tower keeper asks for a password.","options":[{"description":"Guess the old motto","gotoId":"4","consequence":{"type":"LOSE_HEALTH","value":1}}]},{"id":"3","type":"NODE","text":"A vendor offers a brass key.","options":[{"description":"Trade your compass","gotoId":"4"},{"description":"Return to the gate","gotoId":"1"}]},{"id":"4","type":"NODE","text":"A tram races through the station.","options":[{"description":"Board the tram","gotoId":"5"},{"description":"Follow the maintenance tunnel","gotoId":"6","consequence":{"type":"LOSE_HEALTH","value":2}}]},{"id":"5","type":"NODE","text":"The tram reaches the central engine.","options":[{"description":"Inspect the engine","gotoId":"7"}]},{"id":"6","type":"NODE","text":"Sparks illuminate a hidden workshop.","options":[{"description":"Repair a service robot","gotoId":"7","consequence":{"type":"GAIN_HEALTH","value":2}},{"description":"Open the sealed hatch","gotoId":"8"}]},{"id":"7","type":"NODE","text":"The city clock skips a beat.","options":[{"description":"Synchronize the gears","gotoId":"9"},{"description":"Wait for the next cycle","gotoId":"6"}]},{"id":"8","type":"NODE","text":"The hatch leads under the palace.","options":[{"description":"Climb the spiral stairs","gotoId":"10"}]},{"id":"9","type":"NODE","text":"Midnight approaches.","options":[{"description":"Pull the master lever","gotoId":"11"}]},{"id":"10","type":"NODE","text":"A quiet observatory overlooks the city.","options":[{"description":"Signal the rebels","gotoId":"12","consequence":{"type":"LOSE_HEALTH","value":1}}]},{"id":"11","type":"END","text":"The city clock is saved."},{"id":"12","type":"END","text":"The citizens reclaim the engine room."}]}
