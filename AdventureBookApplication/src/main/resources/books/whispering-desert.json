{"id":"whispering-desert","title":"Whispering Desert","author":"Samira Vale","difficulty":"ADVANCED","description":"Cross a desert that remembers every traveller.","sections":[{"id":"1","type":"BEGIN","text":"Sandstorms surround your caravan.","options":[{"description":"Trust the singing dunes","gotoId":"2","consequence":{"type":"LOSE_HEALTH","value":1}},{"description":"Follow the compass","gotoId":"3"}]},{"id":"2","type":"NODE","text":"Voices promise a shortcut.","options":[{"description":"Accept the shortcut","gotoId":"4"},{"description":"Return to the caravan","gotoId":"1"}]},{"id":"3","type":"NODE","text":"An oasis glimmers ahead.","options":[{"description":"Drink and rest","gotoId":"5","consequence":{"type":"GAIN_HEALTH","value":3}},{"description":"Circle the oasis","gotoId":"6"}]},{"id":"4","type":"NODE","text":"The sand opens into ruins.","options":[{"description":"Descend the stairs","gotoId":"7","consequence":{"type":"LOSE_HEALTH","value":2}}]},{"id":"5","type":"NODE","text":"A stone tablet marks north.","options":[{"description":"Study the tablet","gotoId":"6"}]},{"id":"6","type":"NODE","text":"Three obelisks cast one shadow.","options":[{"description":"Choose the tallest","gotoId":"8"},{"description":"Return to the oasis","gotoId":"5"}]},{"id":"7","type":"NODE","text":"A guardian awakens.","options":[{"description":"Answer its riddle","gotoId":"8","consequence":{"type":"LOSE_HEALTH","value":1}}]},{"id":"8","type":"NODE","text":"The desert wind falls silent.","options":[{"description":"Walk toward the silence","gotoId":"9"}]},{"id":"9","type":"NODE","text":"A silver city rises from the sand.","options":[{"description":"Enter the city","gotoId":"10"},{"description":"Mark its location","gotoId":"11"}]},{"id":"10","type":"NODE","text":"The city offers a safe passage.","options":[{"description":"Accept its blessing","gotoId":"12","consequence":{"type":"GAIN_HEALTH","value":1}}]},{"id":"11","type":"END","text":"Your map changes desert exploration forever."},{"id":"12","type":"END","text":"You cross the whispering desert alive."}]}
