{"id":"ironwood-legacy","title":"Ironwood Legacy","author":"Tomas Reed","difficulty":"BEGINNER","description":"Restore an ancient forest guardian.","sections":[{"id":"1","type":"BEGIN","text":"The ironwood forest is silent.","options":[{"description":"Follow the root road","gotoId":"2"},{"description":"Climb the watch tree","gotoId":"3"}]},{"id":"2","type":"NODE","text":"Roots form a natural bridge.","options":[{"description":"Cross the bridge","gotoId":"4"}]},{"id":"3","type":"NODE","text":"You spot a glowing acorn.","options":[{"description":"Collect the acorn","gotoId":"4","consequence":{"type":"GAIN_HEALTH","value":2}},{"description":"Return to the roots","gotoId":"2"}]},{"id":"4","type":"NODE","text":"A wounded stag blocks the path.","options":[{"description":"Treat the stag","gotoId":"5","consequence":{"type":"LOSE_HEALTH","value":1}},{"description":"Walk around it","gotoId":"6"}]},{"id":"5","type":"NODE","text":"The stag reveals a hidden grove.","options":[{"description":"Enter the grove","gotoId":"7"}]},{"id":"6","type":"NODE","text":"Thorns scratch your arms.","options":[{"description":"Push through","gotoId":"7","consequence":{"type":"LOSE_HEALTH","value":2}}]},{"id":"7","type":"NODE","text":"A stone guardian sleeps.","options":[{"description":"Place the acorn","gotoId":"8"},{"description":"Sing the forest song","gotoId":"9"}]},{"id":"8","type":"NODE","text":"The guardian opens one eye.","options":[{"description":"Offer your help","gotoId":"10"}]},{"id":"9","type":"NODE","text":"The trees answer your melody.","options":[{"description":"Follow their answer","gotoId":"10","consequence":{"type":"GAIN_HEALTH","value":1}}]},{"id":"10","type":"NODE","text":"The guardian stands.","options":[{"description":"Guide it to the heartwood","gotoId":"11"}]},{"id":"11","type":"END","text":"The ironwood forest blooms again."},{"id":"12","type":"END","text":"The guardian names you its warden."}]}
