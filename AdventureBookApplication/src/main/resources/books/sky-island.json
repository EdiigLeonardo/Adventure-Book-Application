{"id":"sky-island","title":"Sky Island","author":"Pavel Cloud","difficulty":"INTERMEDIATE","description":"Chart floating islands above the storm.","sections":[{"id":"1","type":"BEGIN","text":"Your airship enters the clouds.","options":[{"description":"Aim for the green island","gotoId":"2"},{"description":"Follow the lightning","gotoId":"3","consequence":{"type":"LOSE_HEALTH","value":1}}]},{"id":"2","type":"NODE","text":"Wind spirits circle the mast.","options":[{"description":"Offer them fruit","gotoId":"4","consequence":{"type":"GAIN_HEALTH","value":1}}]},{"id":"3","type":"NODE","text":"Lightning reveals a hidden island.","options":[{"description":"Land on it","gotoId":"4"},{"description":"Return to clear skies","gotoId":"1"}]},{"id":"4","type":"NODE","text":"A rope bridge spans the islands.","options":[{"description":"Cross the bridge","gotoId":"5","consequence":{"type":"LOSE_HEALTH","value":2}},{"description":"Repair the airship","gotoId":"6"}]},{"id":"5","type":"NODE","text":"You reach a cloud garden.","options":[{"description":"Harvest cloudberries","gotoId":"7","consequence":{"type":"GAIN_HEALTH","value":2}}]},{"id":"6","type":"NODE","text":"The engine purrs again.","options":[{"description":"Chase the sunrise","gotoId":"7"}]},{"id":"7","type":"NODE","text":"A storm wall blocks the horizon.","options":[{"description":"Enter the storm","gotoId":"8","consequence":{"type":"LOSE_HEALTH","value":2}},{"description":"Circle back","gotoId":"6"}]},{"id":"8","type":"NODE","text":"The storm hides a golden compass.","options":[{"description":"Take the compass","gotoId":"9"}]},{"id":"9","type":"NODE","text":"The compass points upward.","options":[{"description":"Climb the cloud tower","gotoId":"10"}]},{"id":"10","type":"NODE","text":"The sky captain awaits.","options":[{"description":"Show the compass","gotoId":"11","consequence":{"type":"GAIN_HEALTH","value":1}}]},{"id":"11","type":"END","text":"The sky captain charts a peaceful route."},{"id":"12","type":"END","text":"Your airship becomes a legend."}]}
