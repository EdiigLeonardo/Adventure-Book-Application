{
  "id": "moonlit-archive",
  "title": "Moonlit Archive",
  "author": "Elena Quill",
  "difficulty": "ADVANCED",
  "description": "Recover a missing chapter from a haunted archive.",
  "sections": [
    {
      "id": "1",
      "type": "BEGIN",
      "text": "The archive opens at moonrise.",
      "options": [
        {
          "description": "Enter the west wing",
          "gotoId": "2"
        },
        {
          "description": "Read the visitor log",
          "gotoId": "3"
        }
      ]
    },
    {
      "id": "2",
      "type": "NODE",
      "text": "Shelves rearrange themselves.",
      "options": [
        {
          "description": "Chase the moving shelf",
          "gotoId": "4",
          "consequence": {
            "type": "LOSE_HEALTH",
            "value": 1
          }
        }
      ]
    },
    {
      "id": "3",
      "type": "NODE",
      "text": "The log names a forbidden room.",
      "options": [
        {
          "description": "Find the room",
          "gotoId": "4"
        },
        {
          "description": "Return at dawn",
          "gotoId": "1"
        }
      ]
    },
    {
      "id": "4",
      "type": "NODE",
      "text": "A librarian ghost points upward.",
      "options": [
        {
          "description": "Climb the rolling ladder",
          "gotoId": "5"
        },
        {
          "description": "Ask for a map",
          "gotoId": "6",
          "consequence": {
            "type": "GAIN_HEALTH",
            "value": 1
          }
        }
      ]
    },
    {
      "id": "5",
      "type": "NODE",
      "text": "The ladder reaches the star index.",
      "options": [
        {
          "description": "Search under S",
          "gotoId": "7"
        }
      ]
    },
    {
      "id": "6",
      "type": "NODE",
      "text": "The map is written in disappearing ink.",
      "options": [
        {
          "description": "Memorize the route",
          "gotoId": "7"
        },
        {
          "description": "Follow the ink trail",
          "gotoId": "8",
          "consequence": {
            "type": "LOSE_HEALTH",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "7",
      "type": "NODE",
      "text": "A locked case hums.",
      "options": [
        {
          "description": "Use the moon key",
          "gotoId": "9"
        },
        {
          "description": "Return to the index",
          "gotoId": "6"
        }
      ]
    },
    {
      "id": "8",
      "type": "NODE",
      "text": "A staircase descends into mist.",
      "options": [
        {
          "description": "Descend",
          "gotoId": "10"
        }
      ]
    },
    {
      "id": "9",
      "type": "NODE",
      "text": "The case contains a blank chapter.",
      "options": [
        {
          "description": "Read aloud",
          "gotoId": "11",
          "consequence": {
            "type": "LOSE_HEALTH",
            "value": 1
          }
        }
      ]
    },
    {
      "id": "10",
      "type": "NODE",
      "text": "The archive foundation remembers everything.",
      "options": [
        {
          "description": "Ask for the missing page",
          "gotoId": "12",
          "consequence": {
            "type": "GAIN_HEALTH",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "11",
      "type": "END",
      "text": "The blank chapter fills with your story."
    },
    {
      "id": "12",
      "type": "END",
      "text": "The archive returns the lost history."
    }
  ]
}
