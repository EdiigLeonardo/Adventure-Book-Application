{
  "id": "ember-circus",
  "title": "Ember Circus",
  "author": "Luca Flame",
  "difficulty": "BEGINNER",
  "description": "Recover a stolen spark during a magical circus night.",
  "sections": [
    {
      "id": "1",
      "type": "BEGIN",
      "text": "The circus tents glow red.",
      "options": [
        {
          "description": "Visit the big top",
          "gotoId": "2"
        },
        {
          "description": "Follow the acrobats",
          "gotoId": "3"
        },
        {
          "description": "Walk into the fire ring alone",
          "gotoId": "game-over",
          "consequence": {
            "type": "LOSE_HEALTH",
            "value": 10
          }
        }
      ]
    },
    {
      "id": "2",
      "type": "NODE",
      "text": "The ringmaster hides a clue.",
      "options": [
        {
          "description": "Search the props",
          "gotoId": "4"
        }
      ]
    },
    {
      "id": "3",
      "type": "NODE",
      "text": "Acrobats point to a mirror tent.",
      "options": [
        {
          "description": "Enter the mirror tent",
          "gotoId": "4",
          "consequence": {
            "type": "LOSE_HEALTH",
            "value": 1
          }
        },
        {
          "description": "Return to the big top",
          "gotoId": "2"
        }
      ]
    },
    {
      "id": "4",
      "type": "NODE",
      "text": "Mirrors show three sparks.",
      "options": [
        {
          "description": "Choose the warm spark",
          "gotoId": "5",
          "consequence": {
            "type": "GAIN_HEALTH",
            "value": 1
          }
        },
        {
          "description": "Choose the cold spark",
          "gotoId": "6",
          "consequence": {
            "type": "LOSE_HEALTH",
            "value": 1
          }
        }
      ]
    },
    {
      "id": "5",
      "type": "NODE",
      "text": "A juggler applauds your choice.",
      "options": [
        {
          "description": "Follow the applause",
          "gotoId": "7"
        }
      ]
    },
    {
      "id": "6",
      "type": "NODE",
      "text": "The cold spark freezes the floor.",
      "options": [
        {
          "description": "Slide to the exit",
          "gotoId": "7"
        }
      ]
    },
    {
      "id": "7",
      "type": "NODE",
      "text": "The fire-eater guards a door.",
      "options": [
        {
          "description": "Offer a candle",
          "gotoId": "8"
        },
        {
          "description": "Challenge the fire",
          "gotoId": "9",
          "consequence": {
            "type": "LOSE_HEALTH",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "8",
      "type": "NODE",
      "text": "The door opens to the backstage.",
      "options": [
        {
          "description": "Search the trunks",
          "gotoId": "10"
        }
      ]
    },
    {
      "id": "9",
      "type": "NODE",
      "text": "The fire becomes a phoenix.",
      "options": [
        {
          "description": "Follow the phoenix",
          "gotoId": "10",
          "consequence": {
            "type": "GAIN_HEALTH",
            "value": 2
          }
        }
      ]
    },
    {
      "id": "10",
      "type": "NODE",
      "text": "The stolen spark floats above a drum.",
      "options": [
        {
          "description": "Catch the spark",
          "gotoId": "11"
        }
      ]
    },
    {
      "id": "11",
      "type": "END",
      "text": "The circus lights blaze again."
    },
    {
      "id": "12",
      "type": "END",
      "text": "The phoenix joins the final parade."
    },
    {
      "id": "game-over",
      "type": "END",
      "text": "The flames overwhelm you before the performance can be saved."
    }
  ]
}
