{"id":"aurora-expedition","title":"Aurora Expedition","author":"Iris North","difficulty":"BEGINNER","description":"A polar expedition beneath dancing lights.","sections":[{"id":"1","type":"BEGIN","text":"Camp beneath the aurora.","options":[{"description":"Follow the blue light","gotoId":"2"},{"description":"Check the old map","gotoId":"3"}]},{"id":"2","type":"NODE","text":"Ice sings under your boots.","options":[{"description":"Cross quickly","gotoId":"4","consequence":{"type":"LOSE_HEALTH","value":1}}]},{"id":"3","type":"NODE","text":"The map reveals a safer ridge.","options":[{"description":"Take the ridge","gotoId":"4"},{"description":"Return to camp","gotoId":"1"}]},{"id":"4","type":"NODE","text":"A frozen ravine blocks the route.","options":[{"description":"Build a bridge","gotoId":"5"},{"description":"Search the cave","gotoId":"6","consequence":{"type":"GAIN_HEALTH","value":1}}]},{"id":"5","type":"NODE","text":"The bridge holds.","options":[{"description":"Climb the ridge","gotoId":"7"}]},{"id":"6","type":"NODE","text":"You find warm supplies.","options":[{"description":"Carry them onward","gotoId":"7"},{"description":"Explore deeper","gotoId":"8","consequence":{"type":"LOSE_HEALTH","value":2}}]},{"id":"7","type":"NODE","text":"The wind rises.","options":[{"description":"Follow the stars","gotoId":"9"},{"description":"Shelter and recover","gotoId":"6"}]},{"id":"8","type":"NODE","text":"A crystal tunnel glows.","options":[{"description":"Enter the tunnel","gotoId":"10"}]},{"id":"9","type":"NODE","text":"A beacon appears.","options":[{"description":"Light the beacon","gotoId":"11"}]},{"id":"10","type":"NODE","text":"The tunnel opens above the clouds.","options":[{"description":"Climb out","gotoId":"12","consequence":{"type":"GAIN_HEALTH","value":2}}]},{"id":"11","type":"END","text":"The rescue team follows your beacon."},{"id":"12","type":"END","text":"You reach the aurora summit."}]}
